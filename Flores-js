function lanzarSorpresa() {
    const body = document.body;
    const deliveryBox = document.getElementById('deliveryBox');

    body.classList.remove('flash-active');
    void body.offsetWidth;
    body.classList.add('flash-active');

    setTimeout(() => {
        body.classList.remove('flash-active');
    }, 500);

    setTimeout(() => {
        deliveryBox.classList.add('show');
    }, 300);

    generarLluvia(['🌼', '🌻', '✨', '💛']);
}

function cambiarLluvia(tipo) {
    document.querySelectorAll('.petal').forEach(p => p.remove());
    let seleccion = [tipo, '✨'];
    if(tipo === '💐') seleccion = ['💐', '💛', '✨'];
    generarLluvia(seleccion);
}

function generarLluvia(elementos) {
    const fragment = document.createDocumentFragment();
    const width = window.innerWidth;

    for (let i = 0; i < 35; i++) {
        const petal = document.createElement('div');
        petal.classList.add('petal');
        petal.innerHTML = elementos[Math.floor(Math.random() * elementos.length)];
        petal.style.left = Math.random() * width + 'px';
        petal.style.animationDuration = (Math.random() * 2 + 1.5) + 's';
        petal.style.fontSize = (Math.random() * 1 + 1) + 'rem';
        
        fragment.appendChild(petal);
        setTimeout(() => { petal.remove(); }, 4000);
    }
    document.body.appendChild(fragment);
}

function cerrarVentana() {
    document.getElementById('deliveryBox').classList.remove('show');
}
